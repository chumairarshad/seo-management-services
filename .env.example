APP_NAME="Portfolio OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Timestamps are always STORED in UTC. This is only how they are displayed,
# and it defines "today"/"this month" for attendance and reporting.
# Any IANA name, e.g. Europe/Berlin, America/New_York, Asia/Karachi.
APP_DISPLAY_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Prefer MySQL on Hostinger; sqlite is fine for local/dev.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=portfolio_os
# DB_USERNAME=root
# DB_PASSWORD=

# Hostinger-safe drivers only (never redis in production)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

# Do not use Redis on shared hosting
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Money
# ---------------------------------------------------------------------------
# All amounts are stored as integer minor units of the base currency.
# MONEY_BASE_EXPONENT is the number of minor-unit digits: 2 for cents/pence,
# 0 for JPY/KRW, 3 for KWD/BHD/OMR. Pick it BEFORE entering any data — stored
# integers carry no scale, so changing it later reinterprets every amount.
MONEY_BASE_CURRENCY=USD
MONEY_BASE_EXPONENT=2
MONEY_BASE_SYMBOL=$

# Optional second currency revenue can be entered in. Each revenue row freezes
# its own FX rate, so historical rows never re-convert. Set this to the same
# value as MONEY_BASE_CURRENCY to run single-currency.
MONEY_SOURCE_CURRENCY=EUR
MONEY_SOURCE_EXPONENT=2
MONEY_SOURCE_SYMBOL=€
MONEY_SOURCE_DEFAULT_RATE=1

# Base-currency major units above which reports flag an expense as notable.
MONEY_LARGE_EXPENSE_THRESHOLD=5000

# ---------------------------------------------------------------------------
# Seeding (php artisan db:seed)
# ---------------------------------------------------------------------------
# Leave empty locally and the demo seeder uses the password "password".
# Outside local/testing the seeder generates a random one and prints it once.
ADMIN_PASSWORD=

# The demo seeders create fake projects, credentials, work, people and money.
# They run automatically when APP_ENV is local or testing, and are skipped
# everywhere else. Set this to true to force them, or false to never run them.
# SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------
# Maintenance route: GET /_ops/{action}?token=…
# ---------------------------------------------------------------------------
# HIGH RISK — runs migrations and cache commands over HTTP for hosts with no
# SSH. Empty disables the route entirely (404). See SECURITY.md.
OPS_TOKEN=
OPS_THROTTLE=5

# ---------------------------------------------------------------------------
# Optional AI assistant
# ---------------------------------------------------------------------------
# Leave all keys empty and the AI features stay completely hidden. Credentials,
# passwords and bank details are never sent to a provider.
AI_PROVIDER=openai
AI_API_KEY=
# Or provider-specific (used if AI_API_KEY empty):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
AI_MODEL=
AI_MONTHLY_BUDGET_CENTS=2000
AI_CACHE_TTL=3600
# AI_HTTP_TIMEOUT=45
# AI_COST_PER_1K_TOKENS_CENTS=0.15
