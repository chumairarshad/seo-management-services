APP_NAME="Portfolio OS"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Display timezone (any IANA name). Timestamps are always stored in UTC.
APP_DISPLAY_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Hostinger MySQL (hPanel → Databases)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Hostinger-safe drivers only — never redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Required behind HTTPS (Hostinger + Cloudflare). Leave true on production.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=ssl

# Money — see .env.example for the full explanation of the exponent.
# Choose the exponent before entering any data; it cannot be changed safely later.
MONEY_BASE_CURRENCY=USD
MONEY_BASE_EXPONENT=2
MONEY_BASE_SYMBOL=$
MONEY_SOURCE_CURRENCY=EUR
MONEY_SOURCE_EXPONENT=2
MONEY_SOURCE_SYMBOL=€
MONEY_SOURCE_DEFAULT_RATE=1
MONEY_LARGE_EXPENSE_THRESHOLD=5000

# First admin password. If empty, `db:seed` generates one and prints it once.
ADMIN_PASSWORD=

# Demo seeders are skipped automatically because APP_ENV is not local. Do not
# set SEED_DEMO_DATA here — it would create fake projects and financial records.

# Maintenance route GET /_ops/{action}?token=… — HIGH RISK, see SECURITY.md.
# Set a long random value only while deploying, then clear it to disable (404).
OPS_TOKEN=
OPS_THROTTLE=5

# Optional AI assistant — leave keys empty so AI stays completely hidden.
AI_PROVIDER=openai
AI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
AI_MODEL=
AI_MONTHLY_BUDGET_CENTS=2000
AI_CACHE_TTL=3600

VITE_APP_NAME="${APP_NAME}"
